{
  "name": "hoteli-poa-pos",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "HOTELI POA POS with a local SQLite demo API",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "build": "node scripts/build-hosting.js",
    "build:hosting": "node scripts/build-hosting.js",
    "check:server": "node --check server/index.js",
    "seed": "node -e \"import('./server/sqlite.js').then(() => console.log('SQLite database initialized.'))\"",
    "promote": "node server/promote-user.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0"
  }
}
