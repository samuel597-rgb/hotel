<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sam_order_tree" model="ir.ui.view">
        <field name="name">sam.pos.order.tree</field>
        <field name="model">sam.pos.order</field>
        <field name="arch" type="xml">
            <tree decoration-success="state=='paid'"
                  decoration-danger="state=='cancelled'">
                <field name="name"/>
                <field name="table_number"/>
                <field name="guest_count"/>
                <field name="customer_name"/>
                <field name="waiter_id"/>
                <field name="total" widget="monetary"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_sam_order_form" model="ir.ui.view">
        <field name="name">sam.pos.order.form</field>
        <field name="model">sam.pos.order</field>
        <field name="arch" type="xml">
            <form string="POS Order">
                <header>
                    <button name="action_pay" type="object" string="Pay"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="table_number"/>
                            <field name="guest_count"/>
                            <field name="customer_name"/>
                        </group>
                        <group>
                            <field name="waiter_id"/>
                            <field name="payment_method"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="category_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="tax_rate"/>
                                    <field name="subtotal" widget="monetary" sum="Subtotal"/>
                                    <field name="tax_amount" widget="monetary" sum="Tax"/>
                                    <field name="total" widget="monetary" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sam_order" model="ir.actions.act_window">
        <field name="name">POS Orders</field>
        <field name="res_model">sam.pos.order</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
