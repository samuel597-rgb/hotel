<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sam_category_tree" model="ir.ui.view">
        <field name="name">sam.pos.category.tree</field>
        <field name="model">sam.pos.category</field>
        <field name="arch" type="xml">
            <tree string="POS Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="department"/>
                <field name="color" widget="color"/>
                <field name="product_count"/>
            </tree>
        </field>
    </record>

    <record id="view_sam_category_form" model="ir.ui.view">
        <field name="name">sam.pos.category.form</field>
        <field name="model">sam.pos.category</field>
        <field name="arch" type="xml">
            <form string="POS Category">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Main Dishes"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="department"/>
                            <field name="sequence"/>
                            <field name="color" widget="color"/>
                            <field name="icon"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="product_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="lst_price" widget="monetary"/>
                                    <field name="unit_label"/>
                                    <field name="is_available"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sam_category" model="ir.actions.act_window">
        <field name="name">POS Categories</field>
        <field name="res_model">sam.pos.category</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
